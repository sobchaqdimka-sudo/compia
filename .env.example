# Скопируй этот файл в .env и впиши свои значения.
# Файл .env в git НЕ попадает (он в .gitignore).

# Токен Telegram-бота. Получить у @BotFather в Telegram.
TELEGRAM_TOKEN=

# Ключ Anthropic API. Взять на https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ключ fal.ai для генерации фото Миры. Взять на https://fal.ai/dashboard/keys
# Если пусто — фича фото выключена, остальной бот работает как обычно.
FAL_KEY=
